# Base URL of the eShopOnWeb PublicApi (see eshoponweb-siva:
# docs/as_is_lld/as_is_lld_catalog.md, Section 11 for the full API contract).
#
# Local .NET dev default (src/PublicApi/appsettings.json -> baseUrls.apiBase):
NEXT_PUBLIC_API_BASE_URL=https://localhost:5099/api/

# NOTE: PublicApi's CORS policy allows exactly one configured origin
# (baseUrls:webBase in the API's appsettings). This app's dev origin
# (typically http://localhost:3000) must be set there, or every API call
# from this app will be blocked by CORS regardless of this URL being correct.
